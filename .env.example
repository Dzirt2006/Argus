VLLM_URL=http://localhost:8000/v1
# MODEL_NAME is auto-discovered from vLLM — uncomment to override:
# MODEL_NAME=Qwen/Qwen3.5-4B
SYSTEM_PROMPT_PATH=docs/system_prompt.md

# Home Assistant (leave empty to disable HA MCP integration)
HA_URL=http://<ha-host>:8123
HA_TOKEN=<paste-long-lived-access-token>

#speach2text
#VOICE_WHISPER_MODEL=medium
VOICE_WHISPER_MODEL=large-v3-turbo
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_PIPER_MODEL=en_US-lessac-medium

#wake word
VOICE_WAKEWORD_MODEL=hey_jarvis
VOICE_WAKEWORD_THRESHOLD=0.3
MAX_STEPS=10

# Memory
MEMORY_ENABLED=true
MEMORY_SQLITE_PATH=/data/memory.db
MEMORY_SUMMARY_MIN_TURNS=2
MEMORY_SUMMARIES_INJECT_N=20

#MCP_SERVERS={"memory": "http://localhost:8007", "filesystem": "http://localhost:8001", "system": "http://localhost:8002", "search": "http://localhost:8003", "weather": "http://localhost:8004", "calendar": "http://localhost:8005", "media": "http://localhost:8006"}
#what is the weather in Verona Wisconsion?
